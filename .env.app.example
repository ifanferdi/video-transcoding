# Origin API yang dipanggil browser (harus reachable dari luar Docker).
NEXT_PUBLIC_API_URL=http://localhost:8100

# Origin API dari dalam container (server component, server action, proxy SSE).
API_INTERNAL_URL=http://api:8100

# Secret gate fitur tulis. Kosong = gate terkunci (fail closed).
# Isi dengan secret acak sebelum deploy: openssl rand -hex 32
UPLOAD_SECRET=
UPLOAD_KEY_TTL=3600

# Profil pembuat (opsional, tampil di dialog About).
NEXT_PUBLIC_PROFILE_FULL_NAME=
NEXT_PUBLIC_PROFILE_EMAIL=
NEXT_PUBLIC_PROFILE_ROLE=
NEXT_PUBLIC_PROFILE_LOCATION=
NEXT_PUBLIC_PROFILE_GITHUB=
NEXT_PUBLIC_PROFILE_LINKEDIN=
NEXT_PUBLIC_PROFILE_INSTAGRAM=
NEXT_PUBLIC_PROFILE_WEBSITE=
