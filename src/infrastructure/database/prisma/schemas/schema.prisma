generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum VideoStatus {
  uploading
  queued
  processing
  ready
  failed
}

// -----------------------------------------------------------------------------
// VIDEO MODELS
// -----------------------------------------------------------------------------

model Video {
  id                 Int         @id @default(autoincrement())
  title              String      @db.VarChar(255)
  status             VideoStatus @default(uploading)
  sourceKey          String      @db.VarChar(500)
  hlsKey             String?     @db.VarChar(500)
  fileSize           BigInt?
  thumbnailTimestamp Int         @default(10)
  error              String?     @db.Text
  createdAt          DateTime    @default(now()) @db.Timestamptz
  updatedAt          DateTime    @updatedAt @db.Timestamptz

  @@index([status], map: "videos_status_index")
  @@index([createdAt], map: "videos_created_at_index")
  @@map("videos")
}
