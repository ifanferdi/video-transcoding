# ================= INFRA =================
# Dipakai compose untuk interpolasi ${...} dan init MinIO.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_transcoding

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ================= APP =================
APP_NAME=Video Transcoding API
APP_VERSION=1.0.0
APP_ENV=production
APP_PORT=8100
APP_URL=http://localhost:8100

# ================= DATABASE =================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/video_transcoding

# ================= REDIS =================
REDIS_URL=redis://redis:6379
REDIS_TTL_SECONDS=21600

# ================= STORAGE (S3 / MinIO) =================
FILESYSTEM=s3
S3_REGION=us-east-1
S3_ACCESS=minioadmin
S3_SECRET=minioadmin
# Internal: diakses container API lewat nama service.
S3_ENDPOINT=http://s3:9000
# Publik: dipakai menandatangani URL yang dibuka browser.
S3_PUBLIC_ENDPOINT=http://localhost:9001
S3_BUCKET=video-transcoding

# ================= UPLOAD LIMITS =================
UPLOAD_SINGLE_MAX_SIZE=1073741824
UPLOAD_MULTIPART_THRESHOLD=104857600
UPLOAD_MULTIPART_CHUNK_SIZE=10485760
UPLOAD_PRESIGN_EXPIRES=3600

# ================= CORS =================
CORS_ORIGINS=http://localhost:3000
