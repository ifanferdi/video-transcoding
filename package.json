{
  "name": "video-transcoding-api",
  "version": "1.0.0",
  "description": "Video Upload & Adaptive Streaming Pipeline API (Bun + Express)",
  "main": "dist/app.js",
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "build": "tsc",
    "start": "bun dist/app.js",
    "typecheck": "tsc --noEmit",
    "prisma": "bunx prisma generate",
    "db:migrate": "bun run prisma && bunx prisma migrate dev --name migrations",
    "db:deploy": "bun run prisma && bunx prisma migrate deploy",
    "db:studio": "bunx prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@bull-board/api": "^9.10.1",
    "@bull-board/express": "^9.10.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "amqplib": "^0.10.9",
    "bullmq": "^6.3.8",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "mime-types": "^3.0.2",
    "moment": "^2.31.0",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "redis": "^6.1.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/bun": "^1.2.23",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.14",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/mime-types": "^3.0.1",
    "@types/morgan": "^1.9.10",
    "@types/pg": "^8.16.0",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "typescript": "^5.9.3"
  }
}
